# Slack browser-session credentials.
#
# These are *your own* session, not a bot token. Get them from a logged-in
# Slack web client (DevTools):
#   XOXC_TOKEN  localStorage -> localConfig_v2 -> teams -> <team> -> token
#               (or the "api_token" in the boot HTML / any api request body)
#   XOXD_TOKEN  the "d" cookie on <workspace>.slack.com
#
# On Enterprise Grid the *enterprise-level* xoxc token (the one whose team is an
# `E…` id) is required for rooms.join; a workspace-level `T…` token gets
# `team_is_restricted`.
#
# Treat both as passwords. They expire -- re-extract when calls start failing
# with not_authed / invalid_auth / token_expired.
XOXC_TOKEN=
XOXD_TOKEN=

# Extra accounts are OPTIONAL.
#
# Drawing in several colours does NOT need them: Slack keeps one line in one
# hue per attendee, and `rooms.join` with multidevice=true returns a fresh
# AttendeeId every call, so one account becomes as many attendees as you have
# colours. `--colors 3` works with just the two tokens above.
#
# Configure extra accounts only if you want the colours spread over different
# Slack users, or if a workspace ever refuses multidevice. Number them
# contiguously -- a gap stops the scan -- and each must be a *different*
# account; duplicates are rejected.
#
# XOXC_TOKEN_2=
# XOXD_TOKEN_2=
# XOXC_TOKEN_3=
# XOXD_TOKEN_3=
#
# Alternatively keep them in a JSON file and pass --accounts-file:
#   [{"xoxc": "xoxc-…", "xoxd": "xoxd-…"}, {"xoxc": "…", "xoxd": "…"}]

# Workspace host for Web API calls. Calls go to https://<host>/api/<method>,
# NOT slack.com/api. e.g. hackclub.slack.com
SLACK_HOST=slack.com

# Chime media region to request from rooms.join. us-east-2 is live-tested;
# us-west-1 and ap-southeast-2 also appear in working clients.
CHIME_MEDIA_REGION=us-east-2
